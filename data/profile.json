{
  "research": [
    {
      "number": "01",
      "title": "Ultrafast electron beams",
      "text": "I study short-pulse electron transport in vacuum and plasma, focusing on how space charge drives pulse broadening, energy spread, and phase-space distortion. My interests extend to beam–plasma acceleration in high-energy-density regimes.",
      "tags": [
        "Space-charge effects",
        "Beam–plasma dynamics"
      ]
    },
    {
      "number": "02",
      "title": "Sheaths & surfaces",
      "text": "I model emission-driven plasma sheaths using fluid and kinetic approaches, including inverse sheath formation and the redistribution of particle fluxes at material interfaces relevant to fusion devices.",
      "tags": [
        "Inverse sheaths",
        "Plasma–surface interactions"
      ]
    },
    {
      "number": "03",
      "title": "Computational plasma physics",
      "text": "I develop and use fluid and kinetic plasma solvers to connect physical models with predictive simulations. My interests include numerical methods and machine learning for reduced-order models of low-temperature and high-energy-density plasmas.",
      "tags": [
        "Fluid & kinetic solvers",
        "Data-driven modeling"
      ]
    }
  ],
