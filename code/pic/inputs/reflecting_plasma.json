{
  "seed": 42,
  "domain": {
    "length": 10,
    "cells": 128,
    "field_boundary": "dirichlet",
    "particle_boundary": {
      "left": "reflecting",
      "right": "reflecting"
    }
  },
  "time": {
    "dt": 0.01,
    "end": 10,
    "diagnostic_interval": 0.5
  },
  "background_charge_density": 0,
  "populations": [
    {
      "name": "electrons",
      "charge": -1,
      "mass": 1,
      "density": 1,
      "particles": 8192,
      "initial": {
        "position": {
          "sampling": "quiet"
        },
        "velocity": {
          "distribution": "maxwellian",
          "drift": 0,
          "thermal_speed": 0.2,
          "sampling": "random"
        }
      }
    },
    {
      "name": "ions",
      "charge": 1,
      "mass": 100,
      "density": 1,
      "particles": 8192,
      "initial": {
        "position": {
          "sampling": "quiet"
        },
        "velocity": {
          "distribution": "maxwellian",
          "drift": 0,
          "thermal_speed": 0.01,
          "sampling": "random"
        }
      }
    }
  ],
  "output": {
    "directory": "../results/general_reflecting_plasma",
    "save_interval": 0.5,
    "particle_dump": "sample",
    "display_particles": 10000
  },
  "phase_space": {
    "position_bins": 128,
    "velocity_bins": 256,
    "velocity_min": -4,
    "velocity_max": 4
  }
}